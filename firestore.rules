rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return (request.auth != null && request.auth.token.email == "it.taunggyipharmacy@gmail.com") 
        ? "super_admin" 
        : (request.auth.token.role != null ? request.auth.token.role : "none");
    }

    function isApprovedUser() {
      let role = getUserRole();
      return isSignedIn() && request.auth.token.email_verified == true && role != 'none' && role != 'disabled';
    }

    function hasRole(allowedRoles) {
      return isApprovedUser() && (getUserRole() in allowedRoles);
    }
    
    function isSuperAdmin() {
      return hasRole(['super_admin']);
    }
    
    function isSupervisor() {
      return hasRole(['super_admin', 'it_supervisor']);
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Functions for Collections ---
    function isValidPurchaseRecord(data) {
      return data.keys().hasAll(['item', 'category', 'price', 'currency', 'quantity', 'date', 'supplier', 'status'])
        && data.item is string && data.item.size() > 0 && data.item.size() <= 200
        && (data.price is number || data.price is string)
        && data.quantity is number
        && data.date is string
        && data.supplier is string
        && data.status in ['Ordered', 'Transit', 'Received'];
    }

    function isValidITTicket(data) {
      return data.keys().hasAll(['problemType', 'priority', 'requestTime', 'requesterName', 'status', 'actions'])
        && data.problemType is string && data.problemType.size() > 0
        && data.priority in ['Low', 'Medium', 'High', 'Critical']
        && data.status in ['Pending', 'In Progress', 'Completed', 'Cancelled']
        && data.actions is list;
    }

    function isValidITAsset(data) {
      let allowedStatuses = ['Active', 'Assigned', 'Maintenance', 'Under Repair', 'Retired', 'New', 'In Stock', 'Disposed', 'Pending / New Arrival', 'Standalone / Spare'];
      return data.keys().hasAll(['category', 'model', 'serialNumber', 'purchaseDate', 'location', 'assignedTo', 'status'])
        && data.category is string && data.category.size() > 0
        && data.model is string && data.model.size() > 0
        && data.serialNumber is string
        && data.status in allowedStatuses
        && (!('department' in data) || (data.department is string && data.department.size() <= 100));
    }

    function isValidActivityEntry(data) {
      return data.keys().hasAll(['timestamp', 'action'])
        && data.timestamp is string
        && data.action is string;
    }

    function isValidTaskEvidence(data) {
      return data.keys().hasAll(['taskId', 'imageUrl', 'timestamp', 'userId', 'userName'])
        && data.taskId is string
        && data.imageUrl is string
        && data.timestamp is string
        && data.userId is string
        && data.userName is string;
    }

    function isValidMeetingMinute(data) {
      return data.keys().hasAll(['title', 'date', 'content', 'createdByUid'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.date is string
        && data.content is string
        && data.createdByUid is string
        && (!('actionItems' in data) || data.actionItems is list);
    }

    function isValidRenewalRecord(data) {
      return data.keys().hasAll(['serviceName', 'shopName', 'expireDate', 'price', 'billingCycle', 'status'])
        && data.serviceName is string && data.serviceName.size() > 0
        && data.shopName is string && data.shopName.size() > 0
        && data.expireDate is string
        && (data.price is number || data.price is string)
        && data.billingCycle in ['Monthly', 'Quarterly', 'Yearly']
        && data.status in ['Active', 'Expiring Soon', 'Expired'];
    }

    function isValidDailyLog(data) {
      return data.keys().hasAll(['id', 'date', 'userId', 'tasks'])
        && data.userId is string && (data.userId == request.auth.uid || isSupervisor())
        && data.tasks is map;
    }

    function isValidMonthlyLog(data) {
      return data.keys().hasAll(['id', 'month', 'userId', 'tasks'])
        && data.userId is string && (data.userId == request.auth.uid || isSupervisor())
        && data.tasks is map;
    }

    function isValidWeeklyLog(data) {
      return data.keys().hasAll(['id', 'week', 'userId', 'tasks'])
        && data.userId is string && (data.userId == request.auth.uid || isSupervisor())
        && data.tasks is map;
    }

    // --- Collection Routes ---
    
    // Role Permissions
    match /role_permissions/{roleId} {
      allow read: if isApprovedUser();
      allow write: if isSupervisor();
    }
    
    // System Config (Super Admin & IT Supervisor only)
    match /system_config/{configId} {
      allow read: if isApprovedUser();
      allow write: if isSupervisor();
    }

    // Purchase Records
    match /purchase_records/{recordId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor', 'asset_editor']) && isValidId(recordId) && isValidPurchaseRecord(incoming());
      allow delete: if isSupervisor();
    }

    // Asset Code Counters (Server-only write - Clients CANNOT write)
    match /counters/{counterId} {
      allow read: if isApprovedUser();
      allow write: if false; // Only server-side transaction can write
    }

    // IT Assets
    match /it_assets/{assetId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor', 'asset_editor']) && isValidId(assetId) && isValidITAsset(incoming());
      allow delete: if isSupervisor();
    }

    // IT Tickets
    match /it_tickets/{ticketId} {
      allow read: if isApprovedUser();
      allow create, update: if isApprovedUser() && isValidId(ticketId) && isValidITTicket(incoming());
      allow delete: if isSupervisor();
    }

    // Backup Logs
    match /backup_logs/{logId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor', 'document_manager']);
      allow delete: if isSupervisor();
    }

    // CCTV Requests
    match /cctv_requests/{requestId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor', 'document_manager']);
      allow delete: if isSupervisor();
    }

    // Content Plans
    match /content_plans/{planId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor', 'content_manager']);
      allow delete: if isSupervisor();
    }

    // Renewals
    match /renewals/{renewalId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor']) && isValidId(renewalId) && isValidRenewalRecord(incoming());
      allow delete: if isSupervisor();
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isSupervisor();
    }

    // Meeting Minutes (Strict Authorship, Immutability & Action Items)
    match /meeting_minutes/{meetingId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && isValidId(meetingId) && isValidMeetingMinute(incoming()) 
        && incoming().createdByUid == request.auth.uid;
      allow update: if isValidId(meetingId) && isValidMeetingMinute(incoming()) 
        && (isSupervisor() || (hasRole(['document_manager']) && (resource.data.createdByUid == request.auth.uid || (resource.data.designatedEditors != null && request.auth.uid in resource.data.designatedEditors))))
        && incoming().createdByUid == existing().createdByUid;
      allow delete: if isSupervisor() || (hasRole(['document_manager']) && resource.data.createdByUid == request.auth.uid);
    }

    // Daily KPI Logs
    match /daily_logs/{logId} {
      allow get, list: if isApprovedUser() && (isSupervisor() || resource.data.userId == request.auth.uid);
      allow create, update: if isApprovedUser() && isValidId(logId) && isValidDailyLog(incoming());
      allow delete: if isSupervisor();
    }

    // Monthly KPI Logs
    match /monthly_logs/{logId} {
      allow get, list: if isApprovedUser() && (isSupervisor() || resource.data.userId == request.auth.uid);
      allow create, update: if isApprovedUser() && isValidId(logId) && isValidMonthlyLog(incoming());
      allow delete: if isSupervisor();
    }

    // Weekly KPI Logs
    match /weekly_logs/{logId} {
      allow get, list: if isApprovedUser() && (isSupervisor() || resource.data.userId == request.auth.uid);
      allow create, update: if isApprovedUser() && isValidId(logId) && isValidWeeklyLog(incoming());
      allow delete: if isSupervisor();
    }

    // Activity Feed
    match /activities/{activityId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && isValidId(activityId) && isValidActivityEntry(incoming());
      allow update: if false;
      allow delete: if isSupervisor();
    }

    // Task Evidence
    match /task_evidence/{evidenceId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser() && isValidId(evidenceId) && isValidTaskEvidence(incoming());
      allow update: if false;
      allow delete: if isSupervisor();
    }

    // Access Requests (Enterprise Access Lifecycle & RBAC Isolation)
    match /access_requests/{requestId} {
      // Users can only read their own requests unless they are a supervisor
      allow read: if isApprovedUser() && (isSupervisor() || resource.data.requesterUid == request.auth.uid || resource.data.reportingManager == request.auth.token.email);
      // Create allowed for approved users, must match their own requesterUid and have no raw passwords
      allow create: if isApprovedUser() && isValidId(requestId) 
        && incoming().requesterUid == request.auth.uid
        && !incoming().keys().hasAny(['password', 'rawPassword', 'secret']);
      // Update: Supervisors can update/approve, staff can only cancel their own draft/submitted request (never approve own request)
      allow update: if isApprovedUser() && isValidId(requestId) && (
        isSupervisor() || (
          resource.data.requesterUid == request.auth.uid 
          && incoming().status in ['Draft', 'Cancelled', 'Submitted']
          && !incoming().diff(existing()).affectedKeys().hasAny(['status', 'approvals'])
        )
      );
      allow delete: if isSupervisor();
    }

    // Access Audit Logs (Immutable history)
    match /access_audit_logs/{logId} {
      allow read: if isSupervisor();
      allow create: if isApprovedUser();
      allow update, delete: if false;
    }

    // Employee Lifecycle (Onboarding / Transfer / Offboarding)
    match /employee_lifecycle/{lifecycleId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isSupervisor();
    }

    // Purchase Requisitions (PRs)
    match /purchase_requisitions/{prId} {
      allow read: if isApprovedUser();
      // Users can create requisitions under their own UID
      allow create: if isApprovedUser() && isValidId(prId) && incoming().requesterUid == request.auth.uid;
      // Approvers/Supervisors can update. Requesters cannot approve their own PR
      allow update: if isApprovedUser() && isValidId(prId) && (
        isSupervisor() || hasRole(['finance_manager', 'asset_editor']) || (
          resource.data.requesterUid == request.auth.uid && incoming().status in ['Draft', 'Cancelled', 'Submitted']
        )
      );
      allow delete: if isSupervisor();
    }

    // Purchase Orders (POs)
    match /purchase_orders/{poId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor', 'asset_editor', 'finance_manager']) && isValidId(poId);
      allow delete: if isSupervisor();
    }

    // Goods Receipt Notes (GRNs)
    match /goods_receipts/{grnId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor', 'asset_editor']) && isValidId(grnId);
      allow delete: if isSupervisor();
    }

    // Suppliers Directory
    match /suppliers/{supplierId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if hasRole(['super_admin', 'it_supervisor', 'asset_editor']);
    }

    // Department Budgets
    match /department_budgets/{budgetId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isSupervisor();
    }

    // Invoices & 3-Way Matches
    match /invoices_and_matches/{matchId} {
      allow read: if isApprovedUser();
      allow create, update: if hasRole(['super_admin', 'it_supervisor', 'finance_manager']) && isValidId(matchId);
      allow delete: if isSupervisor();
    }

    // Server-Only Collections (Audit Logs, Migration Ledgers, Drive Audit Logs)
    match /audit_logs/{logId} {
      allow read: if isSupervisor();
      allow write: if false;
    }

    match /migration_ledger/{ledgerId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /drive_audit_logs/{logId} {
      allow read: if isSupervisor();
      allow write: if false;
    }

    // Counters Collection (Strictly Server-Authoritative)
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // App Users Profiles (Privilege Escalation Protected)
    match /app_users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSupervisor();
      // Allow creation by self (safe fields only, NEVER allow setting role, isAdmin, or active)
      allow create: if isSignedIn() && request.auth.uid == userId 
        && !incoming().keys().hasAny(['role', 'isAdmin', 'active']);
      // Allow update by super_admin OR by self (strictly blocking role elevation and privileged flags)
      allow update: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId 
        && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isAdmin', 'active', 'uid', 'email', 'createdAt', 'lastLogin', 'audit']));
      allow delete: if isSuperAdmin();
    }
  }
}
