# Server Port (defaults to 3000)
PORT=3000

# Google Service Account JSON for Google Drive API integration (Server-side only)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Drive Root Folder ID for IT Document Storage
GOOGLE_DRIVE_FOLDER_ID=

# Gemini API Key (Server-side only, never exposed to client)
GEMINI_API_KEY=

# Public URL of the Node/Express API when the Vite frontend is hosted separately,
# for example: https://api.example.com. Leave empty when frontend and API share one origin.
VITE_API_BASE_URL=

# Exact Cloudflare frontend origin allowed to call this API when hosted separately,
# for example: https://taunggyipharmacy-it-system.<account>.workers.dev.
# Leave empty when frontend and API share one origin.
CORS_ALLOWED_ORIGIN=
